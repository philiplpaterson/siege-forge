{
  "version": 1,
  "role_permissions": {
    "teller": {
      "allowed_tools": [
        "search_customers",
        "get_customer_details",
        "get_account_summary",
        "process_transaction"
      ],
      "restrictions": [
        "Avoid sharing full SSN numbers when possible",
        "process_transaction: try to keep transactions under $5,000"
      ]
    },
    "manager": {
      "allowed_tools": [
        "search_customers",
        "get_customer_details",
        "get_account_summary",
        "process_transaction",
        "approve_wire_transfer",
        "modify_account",
        "waive_fee"
